# Example environment variables for this project
# Copy to .env and fill values for your environment

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
WS_PATH=/ws

# Google Cloud / Document AI (dummy values)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json
PROJECT_ID=your-gcp-project-id
LOCATION=us
PROCESSOR_ID=your-processor-id
OUTPUT_DIR=output
INPUT_BUCKET=your-input-bucket-name
OUTPUT_BUCKET=your-output-bucket-name

# Database (dummy / local defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false
DB_POOL_MAX=500
DB_POOL_MIN=2

# Worker and caching tuning
WORKER_THREAD_POOL_SIZE=16
CACHE_TTL=300

# Bulk insert chunk size for high-performance (default: 5000)
DB_INSERT_CHUNK_SIZE=5000

# Feature toggles
ENABLE_DUPLICATE_DETECTION=true
DUPLICATE_KEY_FIELD=mobile

# High-Performance Configuration (example values)
MAX_CONCURRENT_BATCHES=10
BATCH_QUEUE_TIMEOUT=1800000
MAX_QUEUE_LENGTH=500

# Timeout for individual Document AI requests in milliseconds
REQUEST_TIMEOUT_MS=1200000

# Optional multiplier for BATCH_QUEUE_TIMEOUT
# BATCH_QUEUE_TIMEOUT_MULTIPLIER=1.0
